{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/router.ts": { "includeFiles": "server/postgres/*.sql" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?_focusRoute=:path*" }
  ],
  "crons": [{ "path": "/api/retention", "schedule": "15 3 * * *" }]
}
